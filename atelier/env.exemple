# ================================================================
#  PK Atelier — configuration  (fichier /opt/pk-atelier/.env, droits 600)
#  Après modification :  bash install-atelier.sh   (rejouable)
# ================================================================

# --- Sécurité (générées automatiquement à l'installation) ---
ATELIER_KEY=
ATELIER_SECRET=

# --- Adresses publiques ---
ATELIER_URL_PUBLIQUE=https://atelier.mebeeltech.online
ATELIER_URL_DEMO=https://demo.mebeeltech.online
ATELIER_HOTE_DEMO=demo.mebeeltech.online
ATELIER_FUSEAU=Indian/Reunion

# --- Vendeur : mentions obligatoires des factures ---
# Tant que SIREN/SIRET est vide, les factures portent un bandeau « mentions à compléter » et pas de Factur-X.
VENDEUR_NOM=PixelKréol
VENDEUR_FORME=
VENDEUR_ADRESSE=
VENDEUR_CP_VILLE=
VENDEUR_PAYS=FR
VENDEUR_SIREN=
VENDEUR_SIRET=
VENDEUR_RCS=
VENDEUR_TVA=
VENDEUR_EMAIL=mobeeltech@gmail.com
VENDEUR_TEL=
VENDEUR_SITE=https://pixelkreol.mebeeltech.online
VENDEUR_IBAN=
VENDEUR_BIC=
# true si PixelKréol est en franchise en base de TVA (micro-entreprise) : TVA à 0 et mention art. 293 B du CGI
VENDEUR_FRANCHISE_TVA=false
TVA_DEFAUT=8.5

# --- Envoi des mails (SMTP) ---
# Gmail : SMTP_HOTE=smtp.gmail.com, SMTP_PORT=587, SMTP_UTILISATEUR=mobeeltech@gmail.com,
#         SMTP_MOT_DE_PASSE = un « mot de passe d'application » Google (compte Google > Sécurité > Validation en 2 étapes > Mots de passe des applications)
# Hostinger Mail : SMTP_HOTE=smtp.hostinger.com, SMTP_PORT=465, SMTP_SSL=true
SMTP_HOTE=
SMTP_PORT=587
SMTP_SSL=false
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_EXPEDITEUR=
SMTP_NOM_EXPEDITEUR=PixelKréol

# true (recommandé) : chaque mail attend ton OUI via un lien ; false : envoi direct par les agents
MAIL_VALIDATION=true
# Adresse qui reçoit les demandes de validation (avec le bouton « OUI, envoyer »)
MAIL_NOTIFIER=mobeeltech@gmail.com
# Adresses de confiance qui partent sans validation (séparées par des virgules), ex. ton adresse
MAIL_LISTE_BLANCHE=mobeeltech@gmail.com
MAIL_MAX_PAR_JOUR=50

# --- Sites démo ---
SITE_JOURS_DEFAUT=30
SITE_TAILLE_MAX_MO=15

# --- Hébergement autonome (posé automatiquement par install-atelier.sh) ---
# pk-hebergeur installé : les agents mettent les sites en ligne sans toucher à nginx
HEBERGEMENT_ACTIF=false
# true quand l'enregistrement DNS « *.demo » pointe vers le VPS : chaque démo a son adresse https://<nom>.demo.mebeeltech.online
HEBERGEMENT_SOUS_DOMAINES=false
ATELIER_IP_VPS=
# Adresse pour les avis d'expiration Let's Encrypt (facultatif)
CERTBOT_EMAIL=mobeeltech@gmail.com
