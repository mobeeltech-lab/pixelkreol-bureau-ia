# =====================================================================
#  Instance de TEST « ABI Holding » — modèle de fichier .env
#  Copier :  cp .env.exemple .env   puis  chmod 600 .env  puis remplir les valeurs.
#  Le fichier .env ne doit JAMAIS être envoyé sur GitHub (il est ignoré par Git).
#  Ici : seulement des noms de variables, aucune valeur réelle.
# =====================================================================

# --- Obligatoires -----------------------------------------------------

# Clé que l'orchestrateur présente au LiteLLM de l'instance principale (clé dédiée à ABI, créée sur le serveur).
ABI_LITELLM_KEY=

# Clé entre l'interface (Open WebUI) et l'orchestrateur. Inventer une longue valeur aléatoire.
ABI_API_KEY=

# Clé d'administration de l'orchestrateur (ajout d'agents). Valeur aléatoire différente des autres.
ABI_ADMIN_KEY=

# Mot de passe de la base de données PostgreSQL de l'instance (journal de l'orchestrateur).
ABI_POSTGRES_PASSWORD=

# Secret interne d'Open WebUI (sessions). Longue valeur aléatoire.
ABI_WEBUI_SECRET_KEY=

# --- Facultatives (valeur par défaut entre parenthèses) --------------------

# Nom d'utilisateur de la base (abi)
ABI_POSTGRES_USER=

# Nom de domaine public de l'interface (abi.mebeeltech.online)
ABI_DOMAINE=

# Port local de l'interface, joignable seulement depuis le serveur (3101)
ABI_PORT_WEBUI=

# true le temps de créer le compte administrateur, puis false (false)
ABI_OPENWEBUI_SIGNUP=

# Le routage automatique peut demander à une IA de trancher quand les mots-clés hésitent (true)
ABI_ROUTAGE_IA=

# Écrire « ➜ Agent choisi » au début des réponses de pk-auto (true)
ABI_ANNONCE_AGENT=

# Versions des images (déjà épinglées dans docker-compose.yml ; ne changer que pour aligner sur le serveur)
ABI_PG_IMAGE=
ABI_OPENWEBUI_IMAGE=

# --- Lecture du NAS par l'Archiviste (voir NAS-LISEZMOI.md) ------------------

# 1 pour activer la lecture du NAS (lecture seule), 0 pour l'éteindre (0)
ABI_NAS_ACTIF=

# Chemin, SUR LE SERVEUR, du partage NAS monté en lecture seule (ex. /mnt/nas-abi)
ABI_NAS_CHEMIN=

# Dossiers invisibles pour les agents, séparés par des virgules ; vide = liste par défaut (RH, paie, pièces d'identité…) ; « - » = aucun
ABI_NAS_EXCLUS=

# Taille maximale d'un fichier lu, en Mo (15)
ABI_NAS_TAILLE_MAX_MO=

# Nombre maximal de fichiers examinés par demande quand l'index n'est pas prêt (3000)
ABI_NAS_FICHIERS_MAX=

# Nombre maximal de caractères renvoyés au modèle par demande (6000)
ABI_NAS_CARACTERES_MAX=

# Délai maximal d'une recherche ou d'une lecture, en secondes (20)
ABI_NAS_DELAI=

# Heure de la mise à jour nocturne de l'index, HH:MM, heure de Paris (02:30)
ABI_NAS_NUIT=

# auto : outils puis repli si le modèle ne sait pas appeler d'outils ; outils : outils seulement ; repli : recherche dans l'index seulement (auto)
ABI_NAS_MODE=

# =====================================================================
#  STANDARD TÉLÉPHONIQUE IA — messages vocaux (voir STANDARD-LISEZMOI.md). ÉTEINT PAR DÉFAUT.
#  Pour l'activer : COMPOSE_FILE=docker-compose.yml:docker-compose.standard.yml dans .env (avec le NAS : ...nas.yml:...standard.yml)
#  Les valeurs vides prennent la valeur par défaut donnée entre parenthèses. Mots de passe : uniquement dans .env, jamais ailleurs.
# =====================================================================

# 1 pour allumer le standard, 0 pour l'éteindre (0)
ABI_STANDARD_ACTIF=

# --- Boîte mail dédiée aux messages vocaux (IMAP) -----------------------

# Serveur IMAP de la boîte dédiée (ex. imap.exemple.fr)
ABI_STANDARD_IMAP_HOTE=

# Port IMAP (993)
ABI_STANDARD_IMAP_PORT=

# 1 = connexion chiffrée SSL/TLS, 0 = non chiffrée (réservé aux essais en local) (1)
ABI_STANDARD_IMAP_SSL=

# Adresse de la boîte dédiée (jamais utilisée comme destinataire)
ABI_STANDARD_IMAP_COMPTE=

# Mot de passe de la boîte dédiée (de préférence un mot de passe d'application)
ABI_STANDARD_IMAP_MDP=

# Dossier relevé (INBOX)
ABI_STANDARD_IMAP_DOSSIER=

# Dossier où ranger les messages traités quand IMAP_APRES=ranger (Traité)
ABI_STANDARD_IMAP_DOSSIER_TRAITE=

# lu : le message est seulement marqué lu ; ranger : copié dans le dossier traité puis retiré de la boîte de réception (lu)
ABI_STANDARD_IMAP_APRES=

# Adresses de l'opérateur autorisées à déposer des messages, séparées par des virgules ; vide = tout expéditeur (déconseillé)
ABI_STANDARD_EXPEDITEURS_OK=

# --- Envoi des synthèses (SMTP) -----------------------------------------

# Serveur d'envoi (ex. smtp.exemple.fr)
ABI_STANDARD_SMTP_HOTE=

# Port d'envoi (587)
ABI_STANDARD_SMTP_PORT=

# starttls, ssl ou aucune (starttls)
ABI_STANDARD_SMTP_SECURITE=

# Compte d'envoi (vide si le serveur n'en demande pas)
ABI_STANDARD_SMTP_COMPTE=

# Mot de passe du compte d'envoi
ABI_STANDARD_SMTP_MDP=

# Adresse qui apparaît comme expéditeur des synthèses
ABI_STANDARD_SMTP_EXPEDITEUR=

# --- Qui est prévenu (adresses séparées par des virgules) ------------------

# Vente (programmes neufs, visites)
ABI_STANDARD_DEST_VENTE=

# Location (locataires, baux, quittances)
ABI_STANDARD_DEST_LOCATION=

# Appels de fonds (acquéreurs, notaires)
ABI_STANDARD_DEST_APPEL_DE_FONDS=

# Chantier (entreprises, conducteurs de travaux)
ABI_STANDARD_DEST_CHANTIER=

# Fournisseurs (factures, devis)
ABI_STANDARD_DEST_FOURNISSEUR=

# Administration (mairie, impôts, notaire, assurances)
ABI_STANDARD_DEST_ADMINISTRATION=

# Autre
ABI_STANDARD_DEST_AUTRE=

# OBLIGATOIRE : reçoit tout ce qui n'a pas de destinataire de catégorie, les messages inaudibles et les alertes techniques
ABI_STANDARD_DEST_DEFAUT=

# Reçoit EN PLUS les alertes d'urgence 5 (sinistre, accident) : personne d'astreinte, direction
ABI_STANDARD_DEST_URGENCE=

# Domaines autorisés pour les destinataires (ex. abi-holding.fr) ; vide = pas de contrôle de domaine
ABI_STANDARD_DOMAINES_OK=

# --- Horaires d'ouverture (datent les rappels, signalent un message reçu hors horaires) ---

# Plage d'ouverture HH:MM-HH:MM, heure de Paris (08:00-18:00)
ABI_STANDARD_HORAIRES=

# Jours d'ouverture, 1 = lundi … 7 = dimanche (1-5)
ABI_STANDARD_JOURS=

# --- Transcription locale -------------------------------------------------

# Modèle de voix : small (précis ; mesuré sur le serveur : 16 s pour 60 s d'audio, pic 675 Mo) ou base (léger : 6 s, pic 387 Mo) (small)
ABI_STANDARD_WHISPER_MODELE=

# Cœurs utilisés par la transcription, 1 à 4 (2)
ABI_STANDARD_THREADS=

# Soin de la transcription, 1 (rapide) à 5 (plus lent) (1)
ABI_STANDARD_BEAM=

# Durée maximale transcrite par message, en secondes ; la suite est signalée, jamais perdue (180)
ABI_STANDARD_DUREE_MAX=

# Taille maximale d'un fichier audio, en Mo (15)
ABI_STANDARD_TAILLE_MAX_MO=

# En dessous de ce nombre de mots, le message est traité comme vide ou inaudible (3)
ABI_STANDARD_MOTS_MIN=

# 1 = le modèle est retiré de la mémoire quand il n'y a plus rien à transcrire (1)
ABI_STANDARD_LIBERER_MODELE=

# Mémoire maximale du conteneur (1280m ; 768m suffit pour base)
ABI_STANDARD_MEM=

# Part de processeur maximale du conteneur, sur 2 cœurs au total (1.5)
ABI_STANDARD_CPUS=

# --- Fonctionnement -------------------------------------------------------

# Secondes entre deux relèves de la boîte (120)
ABI_STANDARD_INTERVALLE=

# Nombre maximal de messages traités par relève (5)
ABI_STANDARD_LOT_MAX=

# Garde-fou : synthèses ordinaires envoyées au plus N fois par heure (30)
ABI_STANDARD_MAX_MAILS_HEURE=

# Garde-fou : alertes d'urgence 5 envoyées au plus N fois par heure (10)
ABI_STANDARD_MAX_ALERTES_HEURE=

# Agent du Bureau IA qui classe les messages (secretaire)
ABI_STANDARD_AGENT=

# Délai maximal d'attente de la Secrétaire, en secondes ; au-delà, classement de secours par règles simples (120)
ABI_STANDARD_ORCH_DELAI=

# Conservation des transcriptions, synthèses et tâches, en jours (30)
ABI_STANDARD_CONSERVATION_JOURS=

# Conservation du journal (sans texte, numéros masqués), en jours (365)
ABI_STANDARD_CONSERVATION_JOURNAL=
