# =====================================================================
#  Instance de TEST « ABI Holding » — modèle de fichier .env
#  Copier :  cp .env.exemple .env   puis  chmod 600 .env  puis remplir les valeurs.
#  Le fichier .env ne doit JAMAIS être envoyé sur GitHub (il est ignoré par Git).
#  Ici : seulement des noms de variables, aucune valeur réelle.
# =====================================================================

# --- Obligatoires -----------------------------------------------------

# Clé que l'orchestrateur présente au LiteLLM de l'instance principale (clé dédiée à ABI, créée sur le serveur).
ABI_LITELLM_KEY=

# Clé entre l'interface (Open WebUI) et l'orchestrateur. Inventer une longue valeur aléatoire.
ABI_API_KEY=

# Clé d'administration de l'orchestrateur (ajout d'agents). Valeur aléatoire différente des autres.
ABI_ADMIN_KEY=

# Mot de passe de la base de données PostgreSQL de l'instance (journal de l'orchestrateur).
ABI_POSTGRES_PASSWORD=

# Secret interne d'Open WebUI (sessions). Longue valeur aléatoire.
ABI_WEBUI_SECRET_KEY=

# --- Facultatives (valeur par défaut entre parenthèses) --------------------

# Nom d'utilisateur de la base (abi)
ABI_POSTGRES_USER=

# Nom de domaine public de l'interface (abi.mebeeltech.online)
ABI_DOMAINE=

# Port local de l'interface, joignable seulement depuis le serveur (3101)
ABI_PORT_WEBUI=

# true le temps de créer le compte administrateur, puis false (false)
ABI_OPENWEBUI_SIGNUP=

# Le routage automatique peut demander à une IA de trancher quand les mots-clés hésitent (true)
ABI_ROUTAGE_IA=

# Écrire « ➜ Agent choisi » au début des réponses de pk-auto (true)
ABI_ANNONCE_AGENT=

# Versions des images (déjà épinglées dans docker-compose.yml ; ne changer que pour aligner sur le serveur)
ABI_PG_IMAGE=
ABI_OPENWEBUI_IMAGE=

# --- Lecture du NAS par l'Archiviste (voir NAS-LISEZMOI.md) ------------------

# 1 pour activer la lecture du NAS (lecture seule), 0 pour l'éteindre (0)
ABI_NAS_ACTIF=

# Chemin, SUR LE SERVEUR, du partage NAS monté en lecture seule (ex. /mnt/nas-abi)
ABI_NAS_CHEMIN=

# Dossiers invisibles pour les agents, séparés par des virgules ; vide = liste par défaut (RH, paie, pièces d'identité…) ; « - » = aucun
ABI_NAS_EXCLUS=

# Taille maximale d'un fichier lu, en Mo (15)
ABI_NAS_TAILLE_MAX_MO=

# Nombre maximal de fichiers examinés par demande quand l'index n'est pas prêt (3000)
ABI_NAS_FICHIERS_MAX=

# Nombre maximal de caractères renvoyés au modèle par demande (6000)
ABI_NAS_CARACTERES_MAX=

# Délai maximal d'une recherche ou d'une lecture, en secondes (20)
ABI_NAS_DELAI=

# Heure de la mise à jour nocturne de l'index, HH:MM, heure de Paris (02:30)
ABI_NAS_NUIT=

# auto : outils puis repli si le modèle ne sait pas appeler d'outils ; outils : outils seulement ; repli : recherche dans l'index seulement (auto)
ABI_NAS_MODE=
